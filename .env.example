# ==============================================================================
# FinovaX Platform — Master Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Do NOT commit real secrets (.env) to version control.
# 2. In local development without Docker, copy relevant sections to:
#      - backend/.env
#      - frontend/.env
#      - ai-service/.env
# 3. In Docker production, Docker Compose automatically reads credentials from
#    backend/.env and ai-service/.env, with fallback overrides below.
# ==============================================================================

# ==============================================================================
# 1. BACKEND API GATEWAY CONFIGURATION (backend/.env) [SERVER-ONLY]
# ==============================================================================

# [REQUIRED in Production] Port on which Express listens internally
# Default: 5000
PORT=5000

# [REQUIRED] Runtime mode ('development' or 'production')
# In production, secure cookies and strong secret rules are enforced.
NODE_ENV=production

# [REQUIRED] MongoDB Connection URI (Connecting to MongoDB Atlas over TLS)
# Example Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/finovax?retryWrites=true&w=majority
# Security: Server-only! Never expose to browser or client code.
MONGODB_URI=mongodb+srv://finovax_user:your_secure_password_here@finovax.bhcqkia.mongodb.net/finovax?retryWrites=true&w=majority

# [REQUIRED in Production] JWT Cryptographic Signing Secret
# Requirements: Minimum 32 random characters (64 hex characters recommended).
# Must NOT contain placeholder words like 'dev_secret'.
JWT_SECRET=replace_with_a_cryptographically_secure_random_64_character_hex_string_here

# [OPTIONAL] JWT Expiration Period
# Default: 7d
JWT_EXPIRES_IN=7d

# [REQUIRED in Production] Allowed CORS and Cookie Origin
# In Docker production behind Nginx reverse proxy, client and API share same-origin.
# Default: http://localhost
FRONTEND_URL=http://localhost
CLIENT_URL=http://localhost

# [REQUIRED in Docker] URL of the Python AI Microservice
# In Docker Compose: http://ai-service:8000
# In local development: http://localhost:8000
AI_SERVICE_URL=http://ai-service:8000


# ==============================================================================
# 2. AI INTELLIGENCE MICROSERVICE (ai-service/.env) [SERVER-ONLY]
# ==============================================================================

# [OPTIONAL] AI microservice internal listening port
# Default: 8000
AI_PORT=8000
PORT=8000

# [OPTIONAL] Host binding address
# Default: 0.0.0.0
AI_HOST=0.0.0.0
HOST=0.0.0.0

# [OPTIONAL] Microservice environment stage ('development' or 'production')
ENVIRONMENT=production

# [OPTIONAL] FastAPI Debug Flag (Set to False in production)
DEBUG=False

# [REQUIRED for Admin Actions] Secret key required in X-Admin-Key header for model retraining triggers
# Security: Server-only!
ADMIN_API_KEY=finovax_ai_admin_secret_key_2026_change_in_prod

# [OPTIONAL] Callback URL to Node.js backend
BACKEND_INTERNAL_URL=http://backend:5000


# ==============================================================================
# 3. FRONTEND CLIENT CONFIGURATION (frontend/.env) [BROWSER-VISIBLE]
# ==============================================================================
# CAUTION: Any variable prefixed with VITE_ is embedded directly into the browser
# JavaScript bundle during Vite build time. NEVER put secrets here!

# [OPTIONAL in Production] Base URL for backend API requests.
# In Docker production with Nginx, leave as relative '/api' for same-origin proxying.
# In local development without Docker, use 'http://localhost:5000/api'.
VITE_API_URL=/api

# [OPTIONAL] Base URL of backend host
VITE_API_BASE_URL=http://localhost:5000

# [OPTIONAL] Direct AI service URL (only if bypassing backend proxy)
VITE_AI_SERVICE_URL=http://localhost:8000
