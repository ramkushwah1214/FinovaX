# FinovaX Backend Environment Configuration Example
# Copy this file to .env and configure your environment-specific credentials

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Client URL (for CORS and HttpOnly cookie origins)
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173

# AI Intelligence Service URL
AI_SERVICE_URL=http://localhost:8000

# MongoDB Connection URI (Local instance or MongoDB Atlas cluster connection string)
# Example local: mongodb://localhost:27017/finovax
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/finovax?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/finovax

# JWT Authentication Secret (Use a strong random key with at least 32 characters in production)
JWT_SECRET=your_secure_jwt_secret_key_change_in_production

# JWT Expiration Period (e.g. 7d, 24h)
JWT_EXPIRES_IN=7d

# Cookie Security Settings:
# In development (NODE_ENV=development): SameSite=Lax, Secure=false
# In production (NODE_ENV=production): SameSite=Strict, Secure=true, HttpOnly=true
